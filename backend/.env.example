# ====== WAJIB ======
# AES-256-GCM key untuk enkripsi cerita pengaduan (32 byte = 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY_HEX=

# JWT secret untuk cookie session konselor.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Telegram webhook secret — HARUS unik, acak, minimal 32 karakter.
# Attacker yang mengetahui secret bisa POST webhook palsu ke bot.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ====== DATABASE (Supabase PostgreSQL) ======
# Pakai connection POOLER (bukan direct host) — IPv4 reachable, transaction mode.
# Project: veocdkfohucklvkntpyc (ap-southeast-1)
PGHOST=aws-0-ap-southeast-1.pooler.supabase.com
PGPORT=6543
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# ====== OPSIONAL ======
PORT=3000
NODE_ENV=development
