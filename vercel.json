{
  "version": 2,
  "buildCommand": "cd backend && npm install --omit=dev",
  "outputDirectory": ".",
  "installCommand": "cd backend && npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/konselor", "destination": "/konselor/login.html" },
    { "source": "/konselor/masuk", "destination": "/konselor/login.html" },
    { "source": "/konselor/login", "destination": "/konselor/login.html" },
    { "source": "/program", "destination": "/program.html" },
    { "source": "/((?!konselor|api|_next|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, Cookie" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, OPTIONS" }
      ]
    }
  ]
}
