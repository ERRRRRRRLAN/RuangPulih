{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/program", "destination": "/program.html" },
    { "source": "/konselor", "destination": "/konselor/login.html" },
    { "source": "/konselor/masuk", "destination": "/konselor/login.html" },
    { "source": "/konselor/login", "destination": "/konselor/login.html" },
    { "source": "/konselor/dashboard", "destination": "/konselor/dashboard.html" }
  ],
  "cleanUrls": false
}
